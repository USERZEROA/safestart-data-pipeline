# Settings for docker-compose.yml. `python scripts/start.py` copies this file to .env and fills in a random
# POSTGRES_PASSWORD; keep .env private (git ignores it).

# Password of the `safestart` PostgreSQL user. The database keeps the password it was first created with.
POSTGRES_PASSWORD=
# Host folder of the data root (raw/bulk/, state/, lake/, warehouse/, exports/), mounted at /data: read-only in every
# service but the orchestrator, whose batch flows write it.
DATA_ROOT=./data
# Domain name or public IPv4 address served over HTTPS by docker-compose.public.yml; empty on a workstation.
PUBLIC_DOMAIN=
# Host ports, open on 127.0.0.1 only. Change one if another program already listens on it.
DASHBOARD_HOST_PORT=8501
KAFKA_HOST_PORT=19092
POSTGRES_HOST_PORT=15432
# Optional: a Prefect API for the orchestrator, which then serves the batch and model flows as Prefect deployments.
# For Prefect Cloud, the workspace's API URL (https://api.prefect.cloud/api/accounts/<account>/workspaces/<workspace>)
# and an API key. Left commented out, the orchestrator runs the same schedule by itself.
# PREFECT_API_URL=
# PREFECT_API_KEY=
